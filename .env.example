# Site Configuration
NUXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin Authentication (server-side only, never commit real values)
# 生成口令哈希: node scripts/hash-passphrase.mjs
AUTH_PASSPHRASE_HASH=scrypt:<salt>:<hash>
# 令牌签名密钥: openssl rand -hex 32
AUTH_SECRET=

# Giscus Configuration
# Get these values from https://giscus.app/
NUXT_PUBLIC_GISCUS_REPO=your-username/your-repo
NUXT_PUBLIC_GISCUS_REPO_ID=your-repo-id
NUXT_PUBLIC_GISCUS_CATEGORY=Announcements
NUXT_PUBLIC_GISCUS_CATEGORY_ID=your-category-id

# Analytics (Optional)
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NUXT_PUBLIC_UMAMI_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
